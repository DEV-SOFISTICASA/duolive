# O robô da nuvem NÃO deve carregar logins nem segredos dentro da imagem —
# eles chegam pelo Secret File (sessoes.cofre) e pelas variáveis do Render.
node_modules
npm-debug.log

# logins e cofres (nunca vão para dentro da imagem)
sessao-*.json
*.anterior
sessoes.cofre
*.cofre
.cofre-nuvem

# arquivos de segredo/config locais
cofre.txt
cofre.exemplo.txt
conector.txt
chave-*.txt
senha-*.txt
link-atual.txt
# minhas-lojas.txt NAO entra aqui de proposito: nao e' segredo (so' nomes de
# loja) e o robo da nuvem precisa dele para vigiar SO' as suas lojas, nao as 14.

# ferramentas e dados locais que a nuvem não precisa
cloudflared.exe
